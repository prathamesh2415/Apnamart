{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{../server/prisma/**,../server/src/**,../node_modules/.prisma/client/**,../node_modules/@prisma/client/**}"
    },
    "api/[...path].ts": {
      "maxDuration": 30,
      "includeFiles": "{../server/prisma/**,../server/src/**,../node_modules/.prisma/client/**,../node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
